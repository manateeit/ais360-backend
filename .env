# NetSuite API Configuration
# Replace the values below with your actual NetSuite credentials

# Your NetSuite account ID (found in NetSuite under Setup > Company > Company Information)
NETSUITE_ACCOUNT_ID=3630411

# OAuth 1.0 Consumer Key (from your NetSuite integration record)
NETSUITE_CONSUMER_KEY=5d8c2f4f30545722b7c9a7741db632ea7a126a6c21c36dd51df55e04922d499e

# OAuth 1.0 Consumer Secret (from your NetSuite integration record)
NETSUITE_CONSUMER_SECRET=c885e54eed11b3eedaed9ecf287099b5a50acd29e29fe866265b4f3b07a0cf83

# Token ID (from your NetSuite access token)
NETSUITE_TOKEN_ID=ae64e3f1c5581710ba0859a506e79bd400420d00b21641da9f00be7a9164ef95

# Token Secret (from your NetSuite access token)
NETSUITE_TOKEN_SECRET=d3abce3a6d9ecafe6508d37a3a6194c1bc8269a1d3a8540a0c705dcecb82c98c

# Role ID (usually 3 for Administrator, or your custom role ID)
